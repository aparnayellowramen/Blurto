{
  "name": "blurto",
  "version": "0.1.0",
  "private": true,
  "description": "Blurt o: learn a random concept in 20 minutes, then explain it in 2.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-topics.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "vendor": "node -e \"const f=require('fs');f.mkdirSync('vendor/fonts',{recursive:true});f.copyFileSync('node_modules/three/build/three.module.min.js','vendor/three.module.min.js');const d='node_modules/@fontsource-variable/fredoka/';f.copyFileSync(d+'files/fredoka-latin-wght-normal.woff2','vendor/fonts/fredoka.woff2');f.copyFileSync(d+'LICENSE','vendor/fonts/FREDOKA-LICENSE.txt')\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/fredoka": "5.1.0",
    "three": "0.170.0"
  }
}
